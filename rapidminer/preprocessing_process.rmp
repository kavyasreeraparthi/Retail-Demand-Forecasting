<?xml version="1.0" encoding="UTF-8"?><process version="9.10.001">
  <context>
    <input/>
    <output/>
    <macros/>
  </context>
  <operator activated="true" class="process" compatibility="9.10.001" expanded="true" name="Process">
    <parameter key="logverbosity" value="init"/>
    <parameter key="random_seed" value="2001"/>
    <parameter key="send_mail" value="never"/>
    <parameter key="notification_email" value=""/>
    <parameter key="process_duration_for_mail" value="30"/>
    <parameter key="encoding" value="SYSTEM"/>
    <process expanded="true">

      <!--
        NOTE (read before running):
        This process was authored as a best-effort starting template - it
        was NOT built or verified inside RapidMiner/Altair AI Studio itself
        (no access to the application). Operator class names below match
        RapidMiner's long-standing core operator set and are usually
        stable across versions, but please verify each operator opens
        without a red error icon after import, and re-set the file path
        in "Read CSV" to point at your local data/retail_demand.csv.
        Full manual build instructions (in case anything needs fixing)
        are in rapidminer/HOW_TO_BUILD.md.
      -->

      <operator activated="true" class="read_csv" compatibility="9.10.001" expanded="true" height="68" name="Read CSV" width="90" x="45" y="34">
        <parameter key="csv_file" value="../data/retail_demand.csv"/>
        <parameter key="column_separators" value=","/>
        <parameter key="use_quotes" value="true"/>
        <parameter key="quotes_character" value="&quot;"/>
        <parameter key="escape_character" value="\"/>
        <parameter key="skip_comments" value="false"/>
        <parameter key="first_row_as_names" value="true"/>
        <parameter key="date_format" value="yyyy-MM-dd"/>
        <parameter key="decimal_character" value="."/>
        <parameter key="grouped_digits" value="false"/>
        <parameter key="encoding" value="UTF-8"/>
      </operator>

      <operator activated="true" class="select_attributes" compatibility="9.10.001" expanded="true" height="82" name="Select Attributes" width="90" x="179" y="34">
        <parameter key="attribute_filter_type" value="subset"/>
        <parameter key="attributes" value="Date|Store ID|Product ID|Category|Region|Inventory Level|Units Sold|Units Ordered|Price|Discount|Promotion|Demand"/>
        <parameter key="invert_selection" value="false"/>
        <parameter key="include_special_attributes" value="false"/>
      </operator>

      <operator activated="true" class="replace_missing_values" compatibility="9.10.001" expanded="true" height="103" name="Replace Missing Values" width="90" x="313" y="34">
        <parameter key="return_preprocessing_model" value="false"/>
        <parameter key="create_view" value="false"/>
        <parameter key="attribute_filter_type" value="all"/>
        <parameter key="default" value="average"/>
      </operator>

      <operator activated="true" class="remove_duplicates" compatibility="9.10.001" expanded="true" height="103" name="Remove Duplicates" width="90" x="447" y="34">
        <parameter key="attribute_filter_type" value="all"/>
        <parameter key="treat_missing_values_as_duplicates" value="false"/>
      </operator>

      <operator activated="true" class="generate_attributes" compatibility="9.10.001" expanded="true" height="82" name="Generate Attributes" width="90" x="581" y="34">
        <list key="function_descriptions">
          <parameter key="Year" value="date_get(Date,DATE_UNIT_YEAR,DATE_TIME_ZONE)"/>
          <parameter key="Month" value="date_get(Date,DATE_UNIT_MONTH,DATE_TIME_ZONE)"/>
          <parameter key="Day" value="date_get(Date,DATE_UNIT_DAY,DATE_TIME_ZONE)"/>
          <parameter key="Discounted_Price" value="Price*(1-Discount/100)"/>
          <parameter key="Sell_Through_Rate" value="if([Inventory Level]&gt;0,[Units Sold]/[Inventory Level],0)"/>
        </list>
        <parameter key="keep_all" value="true"/>
      </operator>

      <operator activated="true" class="aggregate" compatibility="9.10.001" expanded="true" height="103" name="Aggregate" width="90" x="715" y="34">
        <parameter key="use_default_aggregation" value="false"/>
        <list key="aggregation_attributes">
          <parameter key="Demand" value="sum"/>
        </list>
        <parameter key="group_by_attributes" value="Date"/>
        <parameter key="count_all_combination" value="false"/>
        <parameter key="only_distinct" value="false"/>
        <parameter key="ignore_missings" value="true"/>
      </operator>

      <operator activated="true" class="sort" compatibility="9.10.001" expanded="true" height="82" name="Sort" width="90" x="849" y="34">
        <parameter key="attribute_name" value="Date"/>
        <parameter key="sorting_direction" value="increasing"/>
      </operator>

      <operator activated="true" class="write_csv" compatibility="9.10.001" expanded="true" height="68" name="Write CSV" width="90" x="983" y="34">
        <parameter key="csv_file" value="../outputs/daily_demand_aggregated_rapidminer.csv"/>
        <parameter key="column_separator" value=","/>
        <parameter key="write_attribute_names" value="true"/>
        <parameter key="quote_nominal_values" value="true"/>
        <parameter key="format_date_attributes" value="true"/>
      </operator>

      <connect from_op="Read CSV" from_port="output" to_op="Select Attributes" to_port="example set input"/>
      <connect from_op="Select Attributes" from_port="example set output" to_op="Replace Missing Values" to_port="example set input"/>
      <connect from_op="Replace Missing Values" from_port="example set output" to_op="Remove Duplicates" to_port="example set input"/>
      <connect from_op="Remove Duplicates" from_port="example set output" to_op="Generate Attributes" to_port="example set input"/>
      <connect from_op="Generate Attributes" from_port="example set output" to_op="Aggregate" to_port="example set input"/>
      <connect from_op="Aggregate" from_port="example set output" to_op="Sort" to_port="example set input"/>
      <connect from_op="Sort" from_port="example set output" to_op="Write CSV" to_port="input"/>
      <connect from_op="Write CSV" from_port="through" to_port="result 1"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>

    </process>
  </operator>
</process>
