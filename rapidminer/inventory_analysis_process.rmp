<?xml version="1.0" encoding="UTF-8"?><process version="9.10.001">
  <context>
    <input/>
    <output/>
    <macros/>
  </context>
  <operator activated="true" class="process" compatibility="9.10.001" expanded="true" name="Process">
    <parameter key="logverbosity" value="init"/>
    <parameter key="random_seed" value="2001"/>
    <parameter key="send_mail" value="never"/>
    <parameter key="notification_email" value=""/>
    <parameter key="process_duration_for_mail" value="30"/>
    <parameter key="encoding" value="SYSTEM"/>
    <process expanded="true">

      <!--
        NOTE - READ BEFORE RUNNING:
        This is a SKELETON. It reads the two inputs you need (the
        forecast, and the raw dataset for current inventory) but the
        join/macro/gap-calculation steps must be added manually inside
        Altair AI Studio, per rapidminer/HOW_TO_BUILD.md (Process 3 table)
        - those steps depend on the exact forecast column name your
        Process 2 build produces, which I can't predict without running it.
      -->

      <operator activated="true" class="read_csv" compatibility="9.10.001" expanded="true" height="68" name="Read Forecast" width="90" x="45" y="34">
        <parameter key="csv_file" value="../outputs/forecast_results_rapidminer.csv"/>
        <parameter key="column_separators" value=","/>
        <parameter key="first_row_as_names" value="true"/>
        <parameter key="date_format" value="yyyy-MM-dd"/>
        <parameter key="encoding" value="UTF-8"/>
      </operator>

      <operator activated="true" class="read_csv" compatibility="9.10.001" expanded="true" height="68" name="Read Raw Inventory" width="90" x="45" y="170">
        <parameter key="csv_file" value="../data/retail_demand.csv"/>
        <parameter key="column_separators" value=","/>
        <parameter key="first_row_as_names" value="true"/>
        <parameter key="date_format" value="yyyy-MM-dd"/>
        <parameter key="encoding" value="UTF-8"/>
      </operator>

      <!--
        <<< ADD HERE (per HOW_TO_BUILD.md, Process 3 table): >>>
        On "Read Raw Inventory": Filter Examples (Date = most recent date)
          -> Aggregate (sum Inventory Level) -> Extract Macro (current_inventory)
        On "Read Forecast": Generate Attributes using the macro:
          Inventory_Gap = Forecast_Demand - %{current_inventory}
          Recommendation = if(Inventory_Gap > 0, "Potential shortage",
                            if(Inventory_Gap < 0, "Sufficient/Surplus",
                            "Approximately sufficient"))
        -> Write CSV to ../outputs/inventory_gap_analysis_rapidminer.csv
      -->

      <connect from_op="Read Forecast" from_port="output" to_port="result 1"/>
      <connect from_op="Read Raw Inventory" from_port="output" to_port="result 2"/>
      <portSpacing port="source_input 1" spacing="0"/>
      <portSpacing port="sink_result 1" spacing="0"/>
      <portSpacing port="sink_result 2" spacing="0"/>
      <portSpacing port="sink_result 3" spacing="0"/>

    </process>
  </operator>
</process>
